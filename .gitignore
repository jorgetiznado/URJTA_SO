# Datos reales (CSV con datos de clientes, fotos de terreno) — solo viven en este PC
data/
fotos/

# Secretos (contraseñas, PIN, clave de sesión) — nunca al repo
.env

# Binario de terceros (52MB, se descarga aparte, no es código fuente)
cloudflared.exe

# Logs
*.log

# Python
__pycache__/
*.pyc

# Configuración local del asistente (no aporta fuera de esta máquina)
.claude/
# ...salvo las habilidades de Danna, que se versionan como el resto de su trabajo
!danna/.claude/
danna/.claude/*
!danna/.claude/skills/

# Extractos de datos reales que Danna use para aprender (contienen datos de clientes)
danna/datos/
