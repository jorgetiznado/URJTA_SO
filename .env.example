# Copia este archivo a .env y completa con los valores reales.
# El .env real NUNCA se sube al repositorio (ver .gitignore).
URJTA_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
URJTA_ADMIN_PASS=cambia-esta-clave-de-admin
URJTA_USUARIO_PIN=cambia-este-pin

# ─── Asistencia (nómina por QR) ───────────────────────────────────────────────
# Los QR se firman con URJTA_SECRET_KEY: si la cambias, hay que reimprimir las credenciales.
URJTA_ASISTENCIA_HORA_ENTRADA=08:30
URJTA_ASISTENCIA_TOLERANCIA_MIN=10
URJTA_ASISTENCIA_PUNTOS=BASE URJTA
# Días hábiles: 1=lunes ... 7=domingo (por defecto, lunes a sábado)
URJTA_ASISTENCIA_DIAS_HABILES=1,2,3,4,5,6
